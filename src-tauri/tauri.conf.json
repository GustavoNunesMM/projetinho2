{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "bancodequestoes",
  "productName": "Banco de Questões",
  "version": "1.4.6",
  "build": {
    "beforeBuildCommand": "pnpm run build",
    "beforeDevCommand": "pnpm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Banco de Questões",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"]
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCMEY0MUIwOEYzRTdBMzAKUldRd2VqNlBzRUVQdStwd3h2WUpINVBkdFhUa3hmQjZ6bXRqSXdXTjJhZzcySGdyUlJuTzdybHMK",
      "endpoints": [
        "https://github.com/GustavoNunesMM/projetinho2/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
