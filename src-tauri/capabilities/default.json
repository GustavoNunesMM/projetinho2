{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões para o Banco de Questões",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "log:default",

    "fs:default",
    "fs:read-file",
    "fs:write-file",
    "fs:read-dir",
    "fs:exists",
    "fs:mkdir",
    "fs:remove",

    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",

    "process:default"
  ],
  "scope": {
    "allow": [
      "$APPDATA/**",
      "$APPDATALOCAL/**",
      "$APPCONFIG/**",
      "$DESKTOP/**",
      "$DOCUMENT/**"
    ]
  }
}
