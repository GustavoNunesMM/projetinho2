{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões para o Banco de Questões",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "log:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-create",
    "fs:allow-exists",

    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:scope-appdata",
    "fs:scope-appdata-recursive",

    "sql:allow-execute",
    "sql:allow-close",
    "sql:allow-load",
    "sql:default",

    "dialog:default",
    "process:default",
    "updater:default"
  ],
  "scope": {
    "allow": [
      "$APPDATA/**",
      "$DOCUMENT/**",
      "$DESKTOP/**",
      "$DOWNLOAD/**",
      "$APPCONFIG/**"
    ]
  }
}
